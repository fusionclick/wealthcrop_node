PORT=3000

# BSE StarMF v2 — MAKER credentials for API (orders, UCC, SIP)
BSE_USERNAME=member/91010/wealthcropsecurities.maker
BSE_PASSWORD=
BSE_MEMBER_CODE=91010
# Demo (public DNS exists). starmfv2.bseindia.com is treated as demo.
BSE_BASE_URL=https://starmfv2demo.bseindia.com

# Demo host often needs this. Omit on a production hostname with a valid cert.
BSE_TLS_INSECURE=1
LARAVEL_WEBHOOK_URL=http://127.0.0.1:8000/api/internal/bse/payment-callback
LARAVEL_INVESTOR_URL=http://127.0.0.1:8000/api/internal/investor-data
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string
